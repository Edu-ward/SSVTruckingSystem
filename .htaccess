# ============================================================
# SSV Trucking System — Apache Configuration
# ============================================================

# ── Database credentials for production ──
# Set these ONLY in InfinityFree File Manager — NEVER commit real values here.
# This file is public on GitHub. Keep all lines below commented out.
# SetEnv DB_HOST     your_mysql_host
# SetEnv DB_NAME     your_db_name
# SetEnv DB_USER     your_db_user
# SetEnv DB_PASS     your_db_password

# ── PHP error display ──
# NOTE: php_flag is NOT supported on InfinityFree (FastCGI).
# Error display is controlled by the hosting panel's PHP settings.

# ── Protect sensitive PHP files from direct access (production only) ──
# These rules are skipped on localhost so local development works normally.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(config|db)\.php$ - [F,L]
</IfModule>

# ── Protect deploy folder ──
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^deploy/ - [F,L]
</IfModule>

# ── Security headers ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Disable directory listing ──
Options -Indexes
